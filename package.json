{
  "name": "the-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && cp server/schema.sql build/server/schema.sql",
    "start": "node build/server/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "session": "node --import tsx scripts/session.ts",
    "load": "node --import tsx scripts/load.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "fastify": "^5.6.1",
    "idb-keyval": "^6.2.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": { "node": ">=22" }
}
